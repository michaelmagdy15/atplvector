default_platform(:ios)
require 'fileutils'
require 'base64'

platform :ios do
  desc "Build and upload app directly to Apple TestFlight"
  lane :beta do
    key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"]
    issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"]
    raw_key = ENV["APP_STORE_CONNECT_KEY_CONTENT"]
    team_id = ENV["APPLE_TEAM_ID"]

    # Decode if base64, otherwise use raw text
    key_content = raw_key.to_s
    if !key_content.include?("BEGIN PRIVATE KEY") && !key_content.include?("BEGIN RSA PRIVATE KEY")
      begin
        decoded = Base64.decode64(key_content)
        key_content = decoded if decoded.include?("PRIVATE KEY")
      rescue => e
      end
    end

    # Write key to standard Apple key locations
    key_dirs = [
      File.expand_path("~/.appstoreconnect/private_keys"),
      File.expand_path("~/.private_keys"),
      File.expand_path("./")
    ]

    key_path = ""
    key_dirs.each do |dir|
      FileUtils.mkdir_p(dir)
      kp = File.join(dir, "AuthKey_#{key_id}.p8")
      File.write(kp, key_content)
      key_path = kp if key_path.empty?
    end

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path,
      is_key_content_base64: false
    )

    clean_team_id = (team_id && !team_id.strip.empty?) ? team_id.strip : ""

    if !clean_team_id.empty?
      update_project_team(
        path: "App.xcodeproj",
        teamid: clean_team_id
      )
      update_code_signing_settings(
        path: "App.xcodeproj",
        use_automatic_signing: true,
        team_id: clean_team_id
      )
    end

    # Authentication arguments for modern xcodebuild (Xcode 13, 14, 15, 16)
    xcargs_opts = "-allowProvisioningUpdates -allowProvisioningDeviceRegistration -authenticationKeyPath '#{key_path}' -authenticationKeyID '#{key_id}' -authenticationKeyIssuerID '#{issuer_id}'"
    if !clean_team_id.empty?
      xcargs_opts += " DEVELOPMENT_TEAM=#{clean_team_id}"
    end

    export_opts = {
      signingStyle: "automatic",
      method: "app-store"
    }
    export_opts[:teamID] = clean_team_id if !clean_team_id.empty?

    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      output_directory: "../build",
      output_name: "App.ipa",
      clean: true,
      export_xcargs: xcargs_opts,
      xcargs: xcargs_opts,
      export_options: export_opts
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: "../build/App.ipa",
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
