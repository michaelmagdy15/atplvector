default_platform(:ios)

platform :ios do
  desc "Build and upload app directly to Apple TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY_CONTENT"],
      is_key_content_base64: false
    )

    team_id = ENV["APPLE_TEAM_ID"]

    xcargs_opts = "-allowProvisioningUpdates"
    export_opts = {
      signingStyle: "automatic",
      method: "app-store"
    }

    if team_id && !team_id.strip.empty?
      clean_team_id = team_id.strip
      xcargs_opts += " DEVELOPMENT_TEAM=#{clean_team_id}"
      export_opts[:teamID] = clean_team_id

      update_project_team(
        path: "App.xcodeproj",
        teamid: clean_team_id
      )
      update_code_signing_settings(
        path: "App.xcodeproj",
        use_automatic_signing: true,
        team_id: clean_team_id
      )
    end

    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      output_directory: "../build",
      output_name: "App.ipa",
      clean: true,
      export_xcargs: xcargs_opts,
      xcargs: xcargs_opts,
      export_options: export_opts
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: "../build/App.ipa",
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
