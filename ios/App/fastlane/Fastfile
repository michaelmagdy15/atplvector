default_platform(:ios)
require 'fileutils'
require 'base64'

platform :ios do
  desc "Build and upload app directly to Apple TestFlight"
  lane :beta do
    key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"].to_s.strip.gsub(/[\r\n\t]/, '')
    issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"].to_s.strip.gsub(/[\r\n\t]/, '')
    team_id = ENV["APPLE_TEAM_ID"].to_s.strip.gsub(/[\r\n\t]/, '')
    clean_team_id = team_id

    # Locate key file
    key_path = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8")
    if !File.exist?(key_path)
      key_path = File.expand_path("~/.private_keys/AuthKey_#{key_id}.p8")
    end

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path,
      is_key_content_base64: false
    )

    app_id = "com.atplvector.app"

    # 1. Update Project Team
    if !clean_team_id.empty?
      update_project_team(
        path: "App.xcodeproj",
        teamid: clean_team_id
      )
    end

    # 2. Ensure App ID exists in Apple Developer Portal
    begin
      produce(
        api_key: api_key,
        app_identifier: app_id,
        app_name: "ATPL Vector",
        team_id: clean_team_id,
        skip_itc: true
      )
    rescue => e
      UI.important("Produce step: #{e.message}")
    end

    # 3. Fetch/Generate App Store Provisioning Profile using Apple REST API
    begin
      sigh(
        api_key: api_key,
        app_identifier: app_id,
        team_id: clean_team_id,
        force: false
      )
    rescue => e
      UI.important("Sigh step: #{e.message}")
    end

    # 4. Build and Package IPA
    xcargs_opts = "-allowProvisioningUpdates -allowProvisioningDeviceRegistration -authenticationKeyPath #{key_path} -authenticationKeyID #{key_id} -authenticationKeyIssuerID #{issuer_id}"
    xcargs_opts += " DEVELOPMENT_TEAM=#{clean_team_id}" if !clean_team_id.empty?

    export_opts = {
      signingStyle: "automatic",
      method: "app-store"
    }
    export_opts[:teamID] = clean_team_id if !clean_team_id.empty?

    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      output_directory: "../build",
      output_name: "App.ipa",
      clean: true,
      export_xcargs: xcargs_opts,
      xcargs: xcargs_opts,
      export_options: export_opts
    )

    # 5. Upload to TestFlight
    upload_to_testflight(
      api_key: api_key,
      ipa: "../build/App.ipa",
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
